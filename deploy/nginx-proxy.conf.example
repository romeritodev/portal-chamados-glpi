# Bloco para a VM 203 (nginx-proxy) — TLS terminado aqui, proxy para o CT 410.
# Ajustar server_name e caminhos dos certificados.

server {
    listen 443 ssl;
    http2 on;
    server_name chamados.exemplo.gov.br;  # AJUSTAR

    ssl_certificate     /etc/letsencrypt/live/chamados.exemplo.gov.br/fullchain.pem;  # AJUSTAR
    ssl_certificate_key /etc/letsencrypt/live/chamados.exemplo.gov.br/privkey.pem;    # AJUSTAR

    # anexos de até 10 MB (Fase 2) + margem
    client_max_body_size 12m;

    location / {
        proxy_pass http://<ip-do-servidor-do-portal>:3000;  # AJUSTAR
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name chamados.exemplo.gov.br;  # AJUSTAR
    return 301 https://$host$request_uri;
}
