# URL do GLPI, sem barra no final. Preferir o endereço interno (mesma rede),
# que evita a volta pela internet. Ex.: http://<ip-interno-do-glpi>
GLPI_URL=

# Cliente OAuth criado no GLPI (Configurar > Clientes OAuth, grant Password, scope api)
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=

# API legada (api.php/v1) — usada para anexos (a v2 não cria o vínculo
# documento→chamado nesta versão do GLPI). App-Token: cliente de API legado
# (Configurar > Geral > API). User token: "Token de API" da conta de serviço.
GLPI_LEGACY_APP_TOKEN=
GLPI_LEGACY_USER_TOKEN=

# Opcional — conta de serviço usada SOMENTE para aprovar solução em nome do
# requerente (o perfil self-service não tem esse direito na API v2).
# Criar no GLPI um usuário dedicado (ex.: portal-svc) com perfil Técnico.
GLPI_SERVICE_USERNAME=
GLPI_SERVICE_PASSWORD=

# Segredo do cookie de sessão (string aleatória de 32+ caracteres)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Nome da instituição, exibido no cabeçalho, na tela de login, no título da
# aba, no aplicativo instalado e no relatório impresso.
PORTAL_INSTITUICAO="Prefeitura Municipal de Exemplo"

# --- Recursos do portal ---
# Estes dois valores são apenas o PADRÃO INICIAL: depois que a equipe de TI
# usar a tela ⚙️ Configurações, o que vale é o que foi gravado lá
# (em <PORTAL_DADOS_DIR>/config.json).
#
# Sino de avisos no cabeçalho (consulta o GLPI a cada 60 s com a aba aberta).
PORTAL_NOTIFICACOES=true
# Painel de atendimento (kanban) da equipe de TI.
PORTAL_PAINEL=true

# Pasta onde o portal grava a configuração feita pela tela ⚙️ (inclui a chave
# da IA). Precisa ser gravável pelo usuário do serviço; criada sozinha na
# primeira gravação, com permissão restrita. Padrão: ./dados
# PORTAL_DADOS_DIR=/opt/chamados-ti/dados

# A chave da IA NÃO fica aqui — é cadastrada pela tela ⚙️ Configurações.

# Avisos no celular (push). O envio é disparado de fora, por um temporizador
# do sistema, em POST /api/push/verificar — veja deploy/chamados-avisos.timer.
# Sem este token a rota fica desativada (503), nunca aberta por engano.
# Gerar com: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
PORTAL_CRON_TOKEN=
# Padrão inicial do liga/desliga (depois vale o que estiver na tela ⚙️):
PORTAL_PUSH=true

# Cookies Secure exigem HTTPS. Deixar "false" apenas enquanto o portal for
# acessado por http:// direto (sem o TLS do nginx-proxy). Em produção com
# HTTPS, remover esta linha ou usar "true".
SECURE_COOKIES=false
